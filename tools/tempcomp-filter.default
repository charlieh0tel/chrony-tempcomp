# /etc/default/tempcomp-filter: settings for tempcomp-filter.sh (draws).
SENSOR=/sys/class/hwmon/hwmon0/temp1_input
# Seconds; 0 passes the reading through unfiltered.
TAU=300
PERIOD=5
OUTPUT=/run/tempcomp-filter/temp
# The tempcomp line's T0: its k0 is 0, so this is no compensation.
OFF_VALUE=54514

#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
set -e

# restart, not try-restart: the filter's own postinst ran before these
# settings left .dpkg-new, so its start was skipped.
if [ "$1" = configure ] && [ -d /run/systemd/system ] \
  && systemctl is-enabled --quiet tempcomp-filter.service; then
  systemctl restart tempcomp-filter.service
fi

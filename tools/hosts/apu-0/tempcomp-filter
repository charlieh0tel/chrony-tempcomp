# /etc/tempcomp-filter.d/host.conf on apu-0, from tempcomp-filter-apu-0.

# The sensor chronyd's tempcomp line read before the filter.
SENSOR=/sys/devices/virtual/thermal/thermal_zone0/hwmon0/temp1_input

# The tempcomp line's T0, when its k0 is 0: no compensation.  Written by
# `tempcomp-filter off`, which removing the package runs.
OFF_VALUE=63223

# Time constant, seconds; 0 passes the reading through unfiltered.  3 min
# from apu-0's raw frequency of 2026-11-06 to 08 (data/filter-gain-apu-0.txt).
TAU=180

# Test 2 (docs/status.md): no compensation on odd UTC days since the epoch.
ALTERNATE_TAU=off

# Seconds between readings.
PERIOD=5

# Seconds between summaries in the log.
STATS_INTERVAL=900

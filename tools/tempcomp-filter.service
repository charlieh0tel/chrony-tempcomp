# Phase 1's filter; settings in /etc/default/tempcomp-filter.
[Unit]
Description=Filtered temperature for chronyd's tempcomp
Before=chrony.service

[Service]
# Simple, not notify: systemd may lose a short-lived systemd-notify's
# message, which would fail the start.  A watchdog ping every PERIOD
# survives a lost one.
Type=simple
NotifyAccess=all
# Not configured yet: skipped, not failed.
ExecCondition=/usr/sbin/tempcomp-filter check
ExecStart=/usr/sbin/tempcomp-filter run
Restart=always
RestartSec=5
WatchdogSec=60
DynamicUser=yes
RuntimeDirectory=tempcomp-filter
RuntimeDirectoryMode=0755
# Keep the state, and the last value chronyd reads, across restarts.
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

# Phase 1's filter; settings in /etc/default/tempcomp-filter and
# /etc/tempcomp-filter.d/*.conf.
[Unit]
Description=Filtered temperature for chronyd's tempcomp
# It writes into chrony's runtime directory, there only while chrony runs.
After=chrony.service
PartOf=chrony.service

[Service]
# Simple, not notify: systemd may lose a short-lived systemd-notify's
# message, which would fail the start.  A watchdog ping every PERIOD
# survives a lost one.
Type=simple
NotifyAccess=all
# Not configured yet: skipped, not failed.
ExecCondition=/usr/sbin/tempcomp-filter check
ExecStart=/usr/sbin/tempcomp-filter run
Restart=always
RestartSec=5
WatchdogSec=60
# chrony's user owns its runtime directory, 0700.
User=_chrony
Group=_chrony
CapabilityBoundingSet=
# The state, kept across restarts.
RuntimeDirectory=tempcomp-filter
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
# "-": not an error while chrony is stopped.
ReadWritePaths=-/run/chrony
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=chrony.service
